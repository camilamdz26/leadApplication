    public static void flagUp (Servo FLAG, Telemetry telemetry){ //This function will raise the flag
        FLAG.setPosition(1); //POSITION 1 BRINGS FLAG UP
        telemetry.addData("FLAG IS UP", FLAG.getPosition()); //Telemetry just to keep track!
        telemetry.update();
    }

    public static void flagDown (Servo FLAG, Telemetry telemetry){ //This function will lower the flag
        FLAG.setPosition(0); //POSITION 0 BRINGS FLAG DOWN
        telemetry.addData("FLAG IS DOWN", FLAG.getPosition()); //Telemetry tells us the flag is down!
        telemetry.update();
    }

    public static void reset_encoders(DcMotor BL, DcMotor BR, DcMotor FL, DcMotor FR){
        //This function stops and resets encoders to ensure that each function works correctly
        BL.setMode(DcMotor.RunMode.STOP_AND_RESET_ENCODER);
        BR.setMode(DcMotor.RunMode.STOP_AND_RESET_ENCODER);
        FL.setMode(DcMotor.RunMode.STOP_AND_RESET_ENCODER);
        FR.setMode(DcMotor.RunMode.STOP_AND_RESET_ENCODER);
        BL.setMode(DcMotor.RunMode.RUN_USING_ENCODER);
        BR.setMode(DcMotor.RunMode.RUN_USING_ENCODER);
        FL.setMode(DcMotor.RunMode.RUN_USING_ENCODER);
        FR.setMode(DcMotor.RunMode.RUN_USING_ENCODER);
    }
    public static void stopMotors (DcMotor BL, DcMotor BR, DcMotor FL, DcMotor FR){
        BL.setPower(0); //This function sets all motor power to 0
        BR.setPower(0);
        FL.setPower(0);
        FR.setPower(0);
    }
    public static void motor_telemetry(Telemetry telemetry, DcMotor BL, DcMotor BR, DcMotor FL, DcMotor FR) {
        telemetry.addData("back left pos", BL.getCurrentPosition());
        telemetry.addData("back right pos", BR.getCurrentPosition());
        telemetry.addData("front left pos", FL.getCurrentPosition());
        telemetry.addData("front right pos", FR.getCurrentPosition());
        telemetry.addData("back left pow", BL.getPower());
        telemetry.addData("back right pow", BR.getPower());
        telemetry.addData("front left pow", FL.getPower());
        telemetry.addData("front right pow", FR.getPower()); //This function just prints everything about the motors
        telemetry.update();
    }

    public static void parkLeft(DcMotor BL, DcMotor BR, DcMotor FL, DcMotor FR, Servo FLAG){

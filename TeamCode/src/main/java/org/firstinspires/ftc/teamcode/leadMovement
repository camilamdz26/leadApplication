public class leadMovement {
    static double rotations;
    public static void forward (double distance, DcMotor BL, DcMotor BR, DcMotor FL, DcMotor FR){
        //This function will take a distance in centimeters and move it forward that distance.
        reset_encoders(BL, BR, FL, FR);//Resets encoders so that the robots position is position 0
        rotations = distance * 21.74; //This will convert it from the inputted inches to the # of rotations it takes
        //The distance is in inches, and it takes around 21.74 rotations to go an inch
        //Below, we set the target position
        FR.setTargetPosition((int) rotations);
        FL.setTargetPosition((int) rotations);
        BL.setTargetPosition((int) rotations);
        BR.setTargetPosition((int) rotations);
        // This will set it to run to position mode, allowing it to go to the target position
        BL.setMode(DcMotor.RunMode.RUN_TO_POSITION);
        BR.setMode(DcMotor.RunMode.RUN_TO_POSITION);
        FL.setMode(DcMotor.RunMode.RUN_TO_POSITION);
        FR.setMode(DcMotor.RunMode.RUN_TO_POSITION);
        FR.setPower(1); //This will turn the power of the motors to 1, making the robot move
        FL.setPower(1);
        BL.setPower(1);
        BR.setPower(1);

        while (BL.isBusy() && BR.isBusy() && FL.isBusy() && FR.isBusy()) {
            telemetry.addData("function", FL.getCurrentPosition());
            motor_telemetry(telemetry, BL, BR, FL, FR); //While it is moving, it will print the positions of motors
            telemetry.update();
        }
        stopMotors(BL, BR, FL, FR); //This sets the power to 0
        reset_encoders(BL, BR, FL, FR); //This resets the encoders, setting the current position to 0
    }
    //All of the other functions do the same thing as the one above, but in different directions!

    public static void backward (double distance,  DcMotor BL, DcMotor BR, DcMotor FL, DcMotor FR){
        //This function will take a distance in centimeters and move it forward that distance.
        reset_encoders(BL, BR, FL, FR);
        rotations = distance * 21.74;
        // SET TARGET POSITION
        FR.setTargetPosition((int) -rotations);
        FL.setTargetPosition((int) -rotations);
        BL.setTargetPosition((int) -rotations);
        BR.setTargetPosition((int) -rotations);
        // RUN TO POSITION
        BL.setMode(DcMotor.RunMode.RUN_TO_POSITION);
        BR.setMode(DcMotor.RunMode.RUN_TO_POSITION);
        FL.setMode(DcMotor.RunMode.RUN_TO_POSITION);
        FR.setMode(DcMotor.RunMode.RUN_TO_POSITION);
        // POWER
        FR.setPower(1);

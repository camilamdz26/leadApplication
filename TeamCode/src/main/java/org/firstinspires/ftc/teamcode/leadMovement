            telemetry.addData("function", FL.getCurrentPosition());
            motor_telemetry(telemetry, BL, BR, FL, FR);
            telemetry.update();
        }
        stopMotors(BL, BR, FL, FR);
        reset_encoders(BL, BR, FL, FR);
    }

